# ============================================================================
# ANZAR Backend — Configuration serveur
# ============================================================================
# Copie ce fichier en .env et remplis tes clés API.
# ⚠️  Ces clés restent UNIQUEMENT sur le serveur. JAMAIS côté client.
# ============================================================================

# ─── Clés API (obligatoire) ───
DEEPSEEK_API_KEY=sk-xxx
# Serper: recherche Google pour le chat IA (2500 gratuits → serper.dev)
SERPER_API_KEY=

# ─── Email (Brevo — ex Sendinblue) ───
# Clé API Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxx
SENDER_EMAIL=noreply@anzar.app
SENDER_NAME=ANZAR
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── URLs API ───
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Serveur ───
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Railway injecte PORT automatiquement — pas besoin de le définir

# ─── Sécurité ───
# OBLIGATOIRE en production: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-IN-PRODUCTION
# Durée de vie du JWT (le client refresh automatiquement, grâce refresh 7j)
JWT_EXPIRY_HOURS=24

# Mot de passe admin initial (min 12 chars). Si vide : mot de passe aléatoire
# généré et affiché UNE fois dans les logs au premier démarrage.
ADMIN_DEFAULT_PASSWORD=
# Clé indépendante pour chiffrer les secrets TOTP des admins.
# Générer avec : openssl rand -hex 32
# Si vide, JWT_SECRET sert de secours (moins bon pour la rotation).
ADMIN_MFA_KEY=
# Passer à true après avoir enrôlé tous les admins.
ADMIN_REQUIRE_MFA=false
# Restriction réseau optionnelle de /api/admin (CIDR séparés par des virgules).
# Exemple : 203.0.113.10/32,10.0.0.0/8
ADMIN_ALLOWED_IPS=

# Origines CORS autorisées (séparées par virgules)
# Ajouter le domaine Tauri de ton app desktop
CORS_ORIGINS=http://localhost:1420,tauri://localhost,https://ton-app.railway.app

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500

# ─── Base de données ───
DATABASE_PATH=./data/anzar.db

# ─── Modèles IA ───
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER=deepseek-reasoner

# ─── Pricing — PRIX DE VENTE (FCFA par 1M tokens, facturés aux utilisateurs) ───
# DeepSeek V4-Flash: coût réel 78/157 F → vente avec marge x3
DEEPSEEK_INPUT_COST_PER_MILLION=250
DEEPSEEK_OUTPUT_COST_PER_MILLION=500
USD_TO_FCFA=560

# Bonus recharge progressif (seuil_FCFA:bonus_%, séparés par virgules)
RECHARGE_BONUS_TIERS=5000:15,15000:25,50000:35

# ─── Mode ───
LOG_LEVEL=info
DEBUG=false

# ─── Concurrence ───
# Plafond de requêtes IA simultanées PAR PROCESSUS (le compteur est local ;
# les réservations de coût, elles, sont en base). Limite effective = N workers × valeur.
MAX_CONCURRENT_AI_PER_USER=4
